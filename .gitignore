# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Never commit site secrets or connector tokens
*.env
.env*
*connector*token*
secrets.*

# Auto-generated local tool state from `gentle-ai skill-registry refresh`; embeds absolute
# developer paths, so it is machine-local, not repo content.
.atl/

# Extracto local para revisar una tira suelta; se regenera desde index.html
.review-*.html

# Scripts de parcheo de un solo uso; nunca son parte del generador
_p*.php
_wire*.php
_ins*.php
