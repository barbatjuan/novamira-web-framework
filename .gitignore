# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Never commit site secrets or connector tokens
*.env
.env*
*connector*token*
secrets.*

# Auto-generated local tool state from `gentle-ai skill-registry refresh`; embeds absolute
# developer paths, so it is machine-local, not repo content.
.atl/

# Extracto local para revisar una tira suelta; se regenera desde index.html
.review-*.html

# Scripts de parcheo de un solo uso; nunca son parte del generador
_p*.php
_wire*.php
_ins*.php

# Generated gallery output — reproducible from _build-gallery.php, never hand-edited. Anchored:
# a bare "index.html" would ignore every such file in the repo, not just this one.
/skills/html-mockup/assets/gallery/index.html

# The client chassis — the second artifact _build-gallery.php emits, same rule as index.html above.
# Lives beside assets/gallery/, not inside it: framework-audit.php's RT_GALLERY_NOT_DISTINCT walk
# treats anything under gallery/ as a candidate multi-strip catalog page.
/skills/html-mockup/assets/chassis/

# Local CodeGraph index; fully derived, machine-local
.codegraph/
